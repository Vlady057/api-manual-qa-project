                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"title\": \"Manual QA API Test\",\n    \"body\": \"Testing POST request in Postman\",\n    \"userId\": 1\n}"
                },
                "url": {
                    "raw": "https://jsonplaceholder.typicode.com/posts",
                    "protocol": "https",
                    "host": [
                        "jsonplaceholder",
                        "typicode",
                        "com"
                    ],
                    "path": [
                        "posts"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const response = pm.response.json();",
                            "",
                            "pm.test(\"Status code is 201\", function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test(\"Response contains the submitted title\", function () {",
                            "    pm.expect(response.title).to.eql(\"Manual QA API Test\");",
                            "});",
                            "",
                            "pm.test(\"Response contains the submitted body\", function () {",
                            "    pm.expect(response.body).to.eql(\"Testing POST request in Postman\");",
                            "});",
                            "",
                            "pm.test(\"Response contains the correct userId\", function () {",
                            "    pm.expect(response.userId).to.eql(1);",
                            "});",
                            "",
                            "pm.test(\"Response contains a generated ID\", function () {",
                            "    pm.expect(response).to.have.property(\"id\");",
                            "    pm.expect(response.id).to.be.a(\"number\");",
                            "});"
                        ]
                    }
                }
            ]
        },
