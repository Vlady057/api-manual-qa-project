{
    "info": {
        "_postman_id": "api-manual-qa-project",
        "name": "API Manual QA Project",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "GET - Get All Posts",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "https://jsonplaceholder.typicode.com/posts",
                    "protocol": "https",
                    "host": [
                        "jsonplaceholder",
                        "typicode",
                        "com"
                    ],
                    "path": [
                        "posts"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const response = pm.response.json();",
                            "",
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Response is an array\", function () {",
                            "    pm.expect(response).to.be.an(\"array\");",
                            "});",
                            "",
                            "pm.test(\"Response contains 100 posts\", function () {",
                            "    pm.expect(response).to.have.lengthOf(100);",
                            "});",
                            "",
                            "pm.test(\"First post has required fields\", function () {",
                            "    pm.expect(response[0]).to.have.property(\"userId\");",
                            "    pm.expect(response[0]).to.have.property(\"id\");",
                            "    pm.expect(response[0]).to.have.property(\"title\");",
                            "    pm.expect(response[0]).to.have.property(\"body\");",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "GET - Get Post By ID",
            "request": {
