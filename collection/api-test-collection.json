                        "exec": [
                            "const response = pm.response.json();",
                            "",
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"Response is an object\", function () {",
                            "    pm.expect(response).to.be.an(\"object\");",
                            "    pm.expect(response).not.to.be.an(\"array\");",
                            "});",
                            "",
                            "pm.test(\"Post ID is 1\", function () {",
                            "    pm.expect(response.id).to.eql(1);",
                            "});",
                            "",
                            "pm.test(\"Required fields exist\", function () {",
                            "    pm.expect(response).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\");",
                            "});",
                            "",
                            "pm.test(\"Title and body are not empty\", function () {",
                            "    pm.expect(response.title).to.be.a(\"string\").and.not.empty;",
                            "    pm.expect(response.body).to.be.a(\"string\").and.not.empty;",
                            "});"
                        ]
                    }
                }
            ]
        },
